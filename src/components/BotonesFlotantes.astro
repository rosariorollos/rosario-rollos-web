---
import { urlWhatsapp } from '../config';
---
{/* Contenedor fijo: el carrito (isla Preact) se inyecta acá al lado del WhatsApp. */}
<div class="flotantes" id="flotantes">
  <a
    class="flotantes__wsp"
    href={urlWhatsapp('Hola, quería hacer una consulta.')}
    target="_blank"
    rel="noopener"
    aria-label="Escribinos por WhatsApp"
    data-evento="click_whatsapp"
  >
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 2a8 8 0 110 16 8 8 0 01-4.1-1.1l-.4-.2-2.5.7.7-2.4-.3-.4A8 8 0 0112 4zm4.3 10.1c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.7 1-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 00-.7.3c-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6a9.6 9.6 0 003.7 3.3c1.4.5 1.9.6 2.6.5.4-.1 1.4-.6 1.6-1.1s.2-1.1.1-1.2z"/>
    </svg>
  </a>

  {/* El botón del carrito se monta acá, al lado del de WhatsApp. */}
  <slot />
</div>

<style is:global>
  /* Barra fija abajo a la derecha con los dos accesos siempre a mano. */
  .flotantes {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .flotantes__wsp {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--whatsapp);
    color: var(--blanco);
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
    flex-shrink: 0;
  }
  .flotantes__wsp:hover { background: #1db954; }

  /* El botón del carrito (Preact) se monta dentro de .flotantes:
     anulamos su posición fija propia para que queden alineados. */
  .flotantes .carrito__lanzador {
    position: static;
    right: auto;
    bottom: auto;
    height: 56px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 480px) {
    .flotantes { right: 0.75rem; bottom: 0.75rem; gap: 0.5rem; }
    .flotantes__wsp { width: 52px; height: 52px; }
    .flotantes .carrito__lanzador { height: 52px; padding-inline: 1rem; font-size: 0.9rem; }
  }
</style>
