---
/**
 * Carrusel del banner principal.
 * Las fotos se deslizan hacia la izquierda cada ciertos segundos, atenuadas
 * con el mismo velo oscuro para que el texto encima se lea siempre.
 */
interface Props {
  imagenes: { src: string; alt: string }[];
  intervalo?: number; // milisegundos entre fotos
}
const { imagenes, intervalo = 6000 } = Astro.props;
---
<div class="carrusel" data-intervalo={intervalo} aria-hidden="true">
  <div class="carrusel__pista" data-pista>
    {imagenes.map((img, i) => (
      <div class="carrusel__slide" data-slide>
        <img
          src={img.src}
          alt=""
          width="1600"
          height="900"
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>
  <div class="carrusel__velo"></div>
</div>

<script>
  for (const carrusel of document.querySelectorAll('.carrusel')) {
    const pista = carrusel.querySelector('[data-pista]');
    const slides = carrusel.querySelectorAll('[data-slide]');
    if (!pista || slides.length < 2) continue;

    // Si el visitante prefiere menos movimiento, no animamos.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const intervalo = Number(carrusel.getAttribute('data-intervalo')) || 6000;
    let actual = 0;
    let timer = null;

    const mostrar = (i) => {
      actual = i % slides.length;
      pista.style.transform = `translate3d(-${actual * 100}%, 0, 0)`;
    };

    const arrancar = () => {
      detener();
      timer = setInterval(() => mostrar(actual + 1), intervalo);
    };
    const detener = () => { if (timer) clearInterval(timer); timer = null; };

    // No gastamos recursos si la pestaña no está visible.
    document.addEventListener('visibilitychange', () => {
      document.hidden ? detener() : arrancar();
    });

    arrancar();
  }
</script>

<style>
  .carrusel { position: absolute; inset: 0; z-index: -1; overflow: hidden; }

  .carrusel__pista {
    display: flex;
    height: 100%;
    width: 100%;
    /* Deslizamiento suave hacia la izquierda */
    transition: transform 1.1s cubic-bezier(0.45, 0, 0.15, 1);
    will-change: transform;
  }
  .carrusel__slide { flex: 0 0 100%; height: 100%; }
  .carrusel__slide img { width: 100%; height: 100%; object-fit: cover; }

  /* Mismo velo que tenía la portada, para que el texto blanco se lea siempre. */
  .carrusel__velo {
    position: absolute; inset: 0;
    /* Velo más liviano: atenúa la foto pero deja verla. */
    background: linear-gradient(
      100deg,
      rgba(15, 60, 76, 0.86) 0%,
      rgba(15, 60, 76, 0.66) 48%,
      rgba(15, 60, 76, 0.42) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .carrusel__pista { transition: none; }
  }
</style>
