---
import { NAV, EMPRESA, urlWhatsapp } from '../config';
import Buscador from './Buscador.astro';
const actual = Astro.url.pathname;

// "Inicio" se saca del menú: para volver a la portada se toca el logo.
const enlaces = NAV.filter((i) => i.href !== '/');
---
<header class="cab">
  <div class="contenedor cab__fila">
    <a href="/" class="cab__logo" aria-label={`${EMPRESA.nombre} — ir al inicio`}>
      <img src="/imagenes/logo-rr.png" alt="" width="200" height="200" loading="eager" decoding="async" />
      <span class="cab__nombre">Rosario<br />Rollos</span>
    </a>

    <Buscador />

    <a class="cab__wsp" href={urlWhatsapp('Hola, quería hacer una consulta.')} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 2a8 8 0 110 16 8 8 0 01-4.1-1.1l-.4-.2-2.5.7.7-2.4-.3-.4A8 8 0 0112 4zm4.3 10.1c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.7 1-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 00-.7.3c-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6a9.6 9.6 0 003.7 3.3c1.4.5 1.9.6 2.6.5.4-.1 1.4-.6 1.6-1.1s.2-1.1.1-1.2z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>

  {/* Menú en UNA sola línea. Si no entra, se desliza en horizontal. */}
  <nav class="cab__nav" aria-label="Principal">
    <div class="contenedor cab__nav-inner">
      {enlaces.map((item) => (
        <a
          href={item.href}
          aria-current={actual === item.href ? 'page' : undefined}
          class:list={['cab__link', { 'cab__link--activo': actual === item.href }]}
        >{item.texto}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .cab { background: var(--blanco); border-bottom: 1px solid var(--celeste-claro); }

  .cab__fila { display: flex; align-items: center; gap: 1rem; padding-block: 0.7rem; }

  .cab__logo {
    display: inline-flex; align-items: center; gap: 0.55rem;
    text-decoration: none; color: var(--celeste-profundo); flex-shrink: 0;
  }
  .cab__logo img { width: 46px; height: 46px; object-fit: contain; }
  .cab__nombre {
    font-family: var(--fuente-titulo); text-transform: uppercase;
    font-weight: 600; font-size: 1.08rem; line-height: 0.95; letter-spacing: 0.02em;
  }


  .cab__wsp {
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: var(--toque-min); padding: 0.5rem 1.1rem;
    border-radius: 999px; background: var(--whatsapp); color: var(--blanco);
    font-weight: 600; font-size: 0.92rem; text-decoration: none; flex-shrink: 0;
  }

  /* Navegación: siempre una sola línea */
  .cab__nav { background: var(--celeste-profundo); }
  .cab__nav-inner {
    display: flex;
    gap: 1.6rem;
    flex-wrap: nowrap;
    padding-block: 0.65rem;
    overflow-x: auto;
    scrollbar-width: none;           /* Firefox */
    -webkit-overflow-scrolling: touch;
  }
  .cab__nav-inner::-webkit-scrollbar { display: none; }
  .cab__link {
    color: #cfe7f0; text-decoration: none; white-space: nowrap;
    font-family: var(--fuente-titulo); text-transform: uppercase;
    font-size: 0.95rem; font-weight: 500; letter-spacing: 0.04em;
    padding: 0.25rem 0;
  }
  .cab__link:hover { color: var(--blanco); }
  .cab__link--activo { color: var(--verde-menta); }

  @media (max-width: 860px) {
    .cab__fila { flex-wrap: wrap; row-gap: 0.6rem; padding-block: 0.6rem; }
    :global(.busca) { order: 3; width: 100%; max-width: none; flex-basis: 100%; margin-inline: 0; }
    .cab__wsp span { display: none; }
    .cab__wsp { padding-inline: 0.8rem; margin-left: auto; }
    .cab__logo img { width: 40px; height: 40px; }
    .cab__nombre { font-size: 0.98rem; }
    .cab__nav-inner { gap: 1.25rem; }
    .cab__link { font-size: 0.9rem; }
  }
</style>
