---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { urlWhatsapp } from '../config';

const categorias = (await getCollection('categorias')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base title="Página no encontrada | Rosario Rollos"
      description="No encontramos la página que buscabas. Mirá nuestro catálogo de rollos térmicos, obra, químico y etiquetas."
      noindex={true}>

  <section class="e404">
    <div class="contenedor e404__inner">
      <p class="sobretitulo">Error 404</p>
      <h1>No encontramos esa página</h1>
      <p class="e404__txt">
        Puede que el enlace esté viejo o que la dirección tenga un error.
        Te dejamos por dónde seguir.
      </p>
      <div class="e404__acciones">
        <a class="boton" href="/productos">Ver el catálogo</a>
        <a class="boton boton--wsp" href={urlWhatsapp('Hola, estaba buscando un producto en la web y no lo encontré.')}
           target="_blank" rel="noopener">Preguntanos por WhatsApp</a>
      </div>
    </div>
  </section>

  <div class="contenedor seccion">
    <h2>Buscá por tipo de papel</h2>
    <ul class="e404__cats">
      {categorias.map((c) => (
        <li><a href={`/${c.data.slug}`}>{c.data.nombre}</a></li>
      ))}
    </ul>

    <p class="e404__busca">
      ¿Sabés la medida? Probá el buscador de arriba: escribí por ejemplo <strong>80x50</strong>,
      <strong>posnet</strong> o <strong>etiquetas</strong>.
    </p>
  </div>
</Base>

<style>
  .e404 { background: var(--celeste-profundo); color: var(--blanco); }
  .e404__inner { padding-block: clamp(2.5rem, 7vw, 4rem); }
  .e404 h1 { color: var(--blanco); }
  .e404__txt { max-width: 46ch; color: #e4f2f7; margin: 0.8rem 0 1.5rem; }
  .e404__acciones { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .seccion { padding-block: clamp(2rem, 5vw, 3rem); }
  .e404__cats {
    list-style: none; padding: 0; margin: 1.2rem 0 0;
    display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }
  .e404__cats a {
    display: block; padding: 0.8rem 1rem; border-radius: var(--radio);
    background: var(--blanco); border: 1px solid var(--celeste-claro);
    text-decoration: none; color: var(--celeste-profundo);
    font-family: var(--fuente-titulo); text-transform: uppercase;
    font-weight: 600; font-size: 0.95rem;
  }
  .e404__cats a:hover { border-color: var(--verde-menta); }
  .e404__busca { margin-top: 1.5rem; color: #4a5a55; }
</style>
