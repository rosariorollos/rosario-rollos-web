---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { EMPRESA, urlWhatsapp } from '../config';

const faq = (await getCollection('faq')).map((f) => f.data).sort((a, b) => a.orden - b.orden);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---
<Base
  title="Preguntas frecuentes y soluciones | Rosario Rollos"
  description="Respuestas a las dudas más comunes: envíos, mínimo de compra, precios mayoristas, qué rollo necesita cada impresora y cómo hacer un pedido.">

  <div class="contenedor">
    <Breadcrumbs items={[{ texto: 'Preguntas frecuentes' }]} />

    <header class="faq-cab">
      <h1>Preguntas frecuentes</h1>
      <p>Las dudas más comunes de nuestros clientes. Si no encontrás la tuya, escribinos.</p>
    </header>

    <div class="faq-lista">
      {faq.map((f) => (
        <details class="faq-item">
          <summary><h2 class="faq-item__preg">{f.pregunta}</h2></summary>
          <p class="faq-item__resp">{f.respuesta}</p>
        </details>
      ))}
    </div>

    <aside class="faq-ayuda">
      <h2>¿No encontraste tu respuesta?</h2>
      <p>Escribinos por WhatsApp y te ayudamos a elegir el rollo que necesita tu equipo.</p>
      <a class="boton boton--wsp" href={urlWhatsapp('Hola, tengo una consulta sobre los rollos.')} target="_blank" rel="noopener">
        Consultar por WhatsApp
      </a>
    </aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .faq-cab { padding-block: 1rem 0.5rem; }
  .faq-cab h1 { font-size: clamp(1.7rem, 5vw, 2.6rem); margin: 0.25rem 0 0.5rem; }
  .faq-cab p { max-width: 60ch; color: #4a5a55; }
  .faq-lista { display: grid; gap: 0.75rem; margin-top: 1.5rem; max-width: 75ch; }
  .faq-item { border: 2px solid var(--verde-menta-claro); border-radius: var(--radio); background: var(--blanco); }
  .faq-item summary {
    cursor: pointer; padding: 0.9rem 1.1rem; list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: var(--toque-min);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--verde); line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item__preg { font-size: 1.02rem; margin: 0; }
  .faq-item__resp { padding: 0 1.1rem 1.1rem; margin: 0; color: #4a5a55; }
  .faq-ayuda {
    margin-top: 2rem; padding: 1.4rem; border-radius: var(--radio);
    background: var(--gris-suave); max-width: 75ch;
  }
  .faq-ayuda h2 { font-size: 1.15rem; margin-top: 0; }
</style>
